{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "bash": "allow",
    "edit": "allow",
    "read": "allow"
  },
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": ["npx", "-y", "context-mode"],
      "enabled": true,
      "timeout": 10000
    }
  }
}