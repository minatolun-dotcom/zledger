# ===== Zledger environment =====
# Copy this file to .env and adjust values before running `docker compose up -d --build`.
#
# Quick start on a new server:
#   cp .env.example .env
#   # Edit .env: set CORS_ORIGINS, server-specific passwords
#   docker compose up -d --build

# --- Application ---
# Change this to a real random secret in production.
JWT_SECRET=kbnTh7g1JQq8LmJbnifLDR3xKSdERYoeKCzprIXGYVi3VNexr5o5RYzcEVszkbv-
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# Initial admin user created on first boot (only if not present)
BOOTSTRAP_ADMIN_EMAIL=admin@zledger.com
BOOTSTRAP_ADMIN_PASSWORD=katheikei
BOOTSTRAP_ADMIN_NAME=Administrator

# --- Database ---
# Change this password in production.
POSTGRES_USER=zledger
POSTGRES_PASSWORD=rxFCCciiBI-9nkS9-6kzF-dAoocwsHtToO7q7-sGGlg
POSTGRES_DB=zledger
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Composed by the app from the above; override here if needed
# DATABASE_URL=postgresql+psycopg://zledger:<password>@db:5432/zledger

# Connection pool (defaults: pool_size=10, max_overflow=20 -> max 30 concurrent connections)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# --- E-Invoice (Phase 11) ---
EINVOICE_ENABLED=false
EINVOICE_ENV=sandbox
# Register at https://einvoice1-trial.nic.in for sandbox credentials
# EINVOICE_GSTIN=
# EINVOICE_CLIENT_ID=
# EINVOICE_CLIENT_SECRET=
# EINVOICE_USERNAME=
# EINVOICE_PASSWORD=

# --- CORS ---
# Comma-separated list of allowed origins. The docker setup proxies /api through nginx,
# so same-origin access needs no extra origin. Add origins here for separate dev servers.
# IMPORTANT: Add your server's public URL here (e.g. https://accounting.example.com)
CORS_ORIGINS=http://localhost:5173,http://192.168.1.110:9090,http://ktserver:9090

# --- Backup ---
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24

# --- Google Drive Backup (optional) ---
# Enable to upload backups to Google Drive via rclone.
# Requires a token file at config/rclone/token.json (see config/rclone/README.md).
GDRIVE_ENABLED=false
# Folder name on Google Drive where backups are uploaded
GDRIVE_REMOTE_PATH=zledger-backups
